# Conexión a PostgreSQL (Neon / Supabase)
# Neon:    postgresql://usuario:password@ep-xxx.region.aws.neon.tech/unitrade?sslmode=require
# Supabase: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://usuario:password@host:5432/unitrade?sslmode=require"

# Servidor
PORT=8081
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# JWT (lo usaremos en el módulo de autenticación)
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"
JWT_EXPIRES_IN=7d

# Pasarela Sandbox (pagos HU-06 y payouts HU-10)
# Tasa de éxito entre 0 y 1. Usa 1 para demos sin fallos aleatorios.
SANDBOX_TASA_EXITO=1
# Retardo simulado del sandbox en milisegundos (0 en desarrollo).
SANDBOX_DEMORA_MS=0
